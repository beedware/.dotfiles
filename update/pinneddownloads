#!/bin/sh
set -eu

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

require() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "$1 is required for pinned download updates." >&2
        exit 1
    fi
}

require curl
require sha256sum
require python3

latest_tag() {
    owner_repo="$1"
    url="$(curl -fsSL -o /dev/null -w '%{url_effective}' "https://github.com/$owner_repo/releases/latest")"
    tag="${url##*/}"
    printf '%s\n' "$tag"
}

version_from_tag() {
    printf '%s\n' "${1#v}"
}

current_version() {
    script="$1"
    python3 - "$script" <<'PY'
import re
import sys

text = open(sys.argv[1], encoding="utf-8").read()
match = re.search(r'^VERSION="([^"]+)"', text, re.M)
if not match:
    raise SystemExit(f"VERSION not found in {sys.argv[1]}")
print(match.group(1))
PY
}

download_checksum() {
    url="$1"
    output="$2"
    curl -fL -o "$output" "$url"
    sha256sum "$output" | cut -d ' ' -f 1
}

patch_simple() {
    script="$1"
    version="$2"
    checksum="$3"
    python3 - "$script" "$version" "$checksum" <<'PY'
import re
import sys

path, version, checksum = sys.argv[1:]
text = open(path, encoding="utf-8").read()
text = re.sub(r'^VERSION="[^"]+"', f'VERSION="{version}"', text, count=1, flags=re.M)
text = re.sub(r'^CHECKSUM="[^"]+"', f'CHECKSUM="{checksum}"', text, count=1, flags=re.M)
open(path, "w", encoding="utf-8").write(text)
PY
}

patch_faugus() {
    script="$1"
    version="$2"
    release="$3"
    checksum="$4"
    python3 - "$script" "$version" "$release" "$checksum" <<'PY'
import re
import sys

path, version, release, checksum = sys.argv[1:]
text = open(path, encoding="utf-8").read()
text = re.sub(r'^VERSION="[^"]+"', f'VERSION="{version}"', text, count=1, flags=re.M)
text = re.sub(r'^RELEASE="[^"]+"', f'RELEASE="{release}"', text, count=1, flags=re.M)
text = re.sub(r'^CHECKSUM="[^"]+"', f'CHECKSUM="{checksum}"', text, count=1, flags=re.M)
open(path, "w", encoding="utf-8").write(text)
PY
}

patch_zed() {
    script="$1"
    version="$2"
    x86_checksum="$3"
    aarch64_checksum="$4"
    python3 - "$script" "$version" "$x86_checksum" "$aarch64_checksum" <<'PY'
import re
import sys

path, version, x86_checksum, aarch64_checksum = sys.argv[1:]
text = open(path, encoding="utf-8").read()
text = re.sub(r'^VERSION="[^"]+"', f'VERSION="{version}"', text, count=1, flags=re.M)
text = re.sub(
    r'(x86_64 \| x86\*\)\n\s*ARCH="x86_64"\n\s*CHECKSUM=")[^"]+(")',
    rf'\g<1>{x86_checksum}\2',
    text,
    count=1,
)
text = re.sub(
    r'(aarch64 \| arm64\*\)\n\s*ARCH="aarch64"\n\s*CHECKSUM=")[^"]+(")',
    rf'\g<1>{aarch64_checksum}\2',
    text,
    count=1,
)
open(path, "w", encoding="utf-8").write(text)
PY
}

run_add() {
    name="$1"
    "$repo_root/add/$name"
}

update_simple_github_asset() {
    name="$1"
    owner_repo="$2"
    tag_prefix="$3"
    asset_template="$4"

    script="$repo_root/add/$name"
    tag="$(latest_tag "$owner_repo")"
    version="$(version_from_tag "$tag")"
    current="$(current_version "$script")"

    if [ "$version" = "$current" ]; then
        echo "$name is already at $version; skipping."
        return
    fi

    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' INT TERM EXIT

    asset="$(printf '%s\n' "$asset_template" | sed "s/@VERSION@/$version/g")"
    url="https://github.com/$owner_repo/releases/download/${tag_prefix}${version}/$asset"
    checksum="$(download_checksum "$url" "$tmp_dir/$asset")"

    patch_simple "$script" "$version" "$checksum"
    rm -rf "$tmp_dir"
    trap - INT TERM EXIT

    run_add "$name"
}

update_heroic() {
    update_simple_github_asset heroic \
        Heroic-Games-Launcher/HeroicGamesLauncher \
        v \
        'Heroic-@VERSION@-linux-x86_64.AppImage'
}

update_vial() {
    update_simple_github_asset vial \
        vial-kb/vial-gui \
        v \
        'Vial-v@VERSION@-x86_64.AppImage'
}

update_helium() {
    update_simple_github_asset helium \
        imputnet/helium-linux \
        '' \
        'helium-@VERSION@-x86_64.AppImage'
}

update_wayvr() {
    update_simple_github_asset wayvr \
        wayvr-org/wayvr \
        v \
        'WayVR-v@VERSION@-x86_64.AppImage'
}

update_faugus() {
    name=faugus
    owner_repo=Faugus/faugus-launcher
    script="$repo_root/add/$name"
    tag="$(latest_tag "$owner_repo")"
    version="$(version_from_tag "$tag")"
    current="$(current_version "$script")"

    if [ "$version" = "$current" ]; then
        echo "$name is already at $version; skipping."
        return
    fi

    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' INT TERM EXIT

    release=1
    while :; do
        asset="Faugus-${version}-${release}-x86_64.AppImage"
        url="https://github.com/$owner_repo/releases/download/$version/$asset"
        if checksum="$(download_checksum "$url" "$tmp_dir/$asset" 2>/dev/null)"; then
            break
        fi
        rm -f "$tmp_dir/$asset"
        release=$((release + 1))
        if [ "$release" -gt 20 ]; then
            echo "Could not find Faugus AppImage release asset for $version." >&2
            exit 1
        fi
    done

    patch_faugus "$script" "$version" "$release" "$checksum"
    rm -rf "$tmp_dir"
    trap - INT TERM EXIT

    run_add "$name"
}

update_zed() {
    name=zed
    owner_repo=zed-industries/zed
    script="$repo_root/add/$name"
    tag="$(latest_tag "$owner_repo")"
    version="$(version_from_tag "$tag")"
    current="$(current_version "$script")"

    if [ "$version" = "$current" ]; then
        echo "$name is already at $version; skipping."
        return
    fi

    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' INT TERM EXIT

    x86_asset=zed-linux-x86_64.tar.gz
    aarch64_asset=zed-linux-aarch64.tar.gz
    x86_checksum="$(download_checksum "https://github.com/$owner_repo/releases/download/v$version/$x86_asset" "$tmp_dir/$x86_asset")"
    aarch64_checksum="$(download_checksum "https://github.com/$owner_repo/releases/download/v$version/$aarch64_asset" "$tmp_dir/$aarch64_asset")"

    patch_zed "$script" "$version" "$x86_checksum" "$aarch64_checksum"
    rm -rf "$tmp_dir"
    trap - INT TERM EXIT

    run_add "$name"
}

update_espanso() {
    name=espanso
    owner_repo=espanso/espanso
    script="$repo_root/add/$name"
    tag="$(latest_tag "$owner_repo")"
    version="$(version_from_tag "$tag")"
    current="$(current_version "$script")"

    if [ "$version" = "$current" ]; then
        echo "$name is already at $version; skipping."
        return
    fi

    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' INT TERM EXIT

    asset="espanso-${version}.tar.gz"
    checksum="$(download_checksum "https://github.com/$owner_repo/archive/refs/tags/v$version.tar.gz" "$tmp_dir/$asset")"

    patch_simple "$script" "$version" "$checksum"
    rm -rf "$tmp_dir"
    trap - INT TERM EXIT

    run_add "$name"
}

update_heroic
update_faugus
update_zed
update_vial
update_helium
update_wayvr
update_espanso
