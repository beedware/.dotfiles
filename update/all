#!/bin/sh
set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(dirname -- "$script_dir")"

run_update() {
    name="$1"
    printf '\n==> update/%s\n' "$name"
    "$script_dir/$name"
}

run_update dotfiles
run_update flatpak
run_update node
run_update rust
run_update haskell
run_update flutter
run_update sdkman
run_update python
run_update void-packages
run_update pinneddownloads
run_update org-cals

cd "$repo_root"

if git diff --quiet && git diff --cached --quiet && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    echo "No dotfiles changes to commit."
    exit 0
fi

git status --short
git add add update .stow-local-ignore
git commit -m "Update managed tools"

printf 'Push update commit? [y/N]: '
read -r choice
case "$choice" in
    y|Y|yes|YES) git push ;;
esac
