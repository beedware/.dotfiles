#!/bin/sh
set -eu

if command -v volta >/dev/null 2>&1; then
    volta install node
else
    echo "volta is not installed; skipping Node runtime update."
fi

if ! command -v npm >/dev/null 2>&1; then
    echo "npm is not installed; skipping global npm updates."
    exit 0
fi

npm update -g
npm i -g opencode-ai --allow-scripts=opencode-ai
