#!/bin/sh
set -eu

if ! command -v rustup >/dev/null 2>&1; then
    echo "rustup is not installed; skipping."
    exit 0
fi

rustup update

if ! command -v cargo >/dev/null 2>&1; then
    echo "cargo is not installed after rustup update; skipping cargo tools."
    exit 0
fi

cargo install tex-fmt --locked --force
cargo install --git=https://github.com/antonWetzel/prettypst.git --locked --force
