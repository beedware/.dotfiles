#!/usr/bin/env python3

from __future__ import annotations

import os
import subprocess
import sys
from collections.abc import Iterable, Sequence
from dataclasses import dataclass
from pathlib import Path
from subprocess import CompletedProcess, Popen

SRC_DIR: Path = Path.home() / "Projects"
SRC_DIR.mkdir(parents=True, exist_ok=True)


@dataclass(frozen=True)
class DirectorySource:
    base_dir: Path
    depth: int
    key_prefix: str = ""
    include_hidden: bool = False


@dataclass(frozen=True)
class LauncherConfig:
    static_targets: dict[str, Path]
    directory_sources: Sequence[DirectorySource]
    default_target: Path


CONFIG = LauncherConfig(
    static_targets={
        "dotfiles": Path("~/.dotfiles"),
        "home": Path("~"),
        "local/share": Path("~/.dotfiles/.local/share"),
        "local/bin": Path("~/.dotfiles/.local/bin"),
        "tmp": Path("/tmp"),
    },
    directory_sources=(
        DirectorySource(base_dir=Path("~/Projects"), depth=2, include_hidden=True),
        DirectorySource(
            base_dir=Path("~/.dotfiles/.config"), depth=1, key_prefix="config/"
        ),
        DirectorySource(
            base_dir=Path("~/.dotfiles/.local/share"), depth=1, key_prefix="local/share/"
        ),
        DirectorySource(
            base_dir=Path("~/Compendium"), depth=1, key_prefix="compendium/"
        ),
        DirectorySource(
            base_dir=Path("~/Compendium/Notebook"), depth=1, key_prefix="compendium/Nootbook/"
        ),
        DirectorySource(base_dir=Path("~"), depth=1, key_prefix="home/"),
    ),
    default_target=Path("~"),
)


def run(cmd: list[str], **kwargs) -> CompletedProcess[str]:
    return subprocess.run(cmd, check=True, text=True, **kwargs)


def find_dirs(
    base_dir: Path, depth: int = 1, include_hidden: bool = False
) -> list[str]:
    if depth < 1:
        return []

    base: Path = base_dir.expanduser().resolve()
    if not base.is_dir():
        return []

    result: list[str] = []
    base_depth: int = len(base.parts)

    for root, dirs, _ in os.walk(base):
        if not include_hidden:
            dirs[:] = [d for d in dirs if not d.startswith(".")]

        current: int = len(Path(root).parts) - base_depth

        if current > depth:
            dirs.clear()
            continue

        if current == depth:
            rel: Path = Path(root).relative_to(base)
            result.append(rel.as_posix())
            dirs.clear()

    return result


def add_paths(
    out: dict[str, str],
    items: Iterable[str],
    prefix: str,
    base: Path,
) -> None:
    resolved_base: Path = base.expanduser().resolve()

    for p in items:
        key: str = f"{prefix}{p}" if prefix else p
        out[key] = str((resolved_base / p).as_posix())


def create_mapping(config: LauncherConfig) -> dict[str, str]:
    out: dict[str, str] = {
        name: str(path.expanduser().resolve())
        for name, path in config.static_targets.items()
    }

    for source in config.directory_sources:
        add_paths(
            out=out,
            items=find_dirs(source.base_dir, source.depth, source.include_hidden),
            prefix=source.key_prefix,
            base=source.base_dir,
        )

    return out


def get_tmux_items() -> list[str]:
    try:
        out: str = subprocess.check_output(
            ["tmux", "list-sessions", "-F", "#S"],
            stderr=subprocess.DEVNULL,
            text=True,
        )
        return out.splitlines()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return []


def get_all_items(config: LauncherConfig) -> tuple[list[str], dict[str, str]]:
    mapping: dict[str, str] = create_mapping(config)

    tmux: set[str] = set(get_tmux_items())
    keys: set[str] = set(mapping)
    normalized_tmux: set[str] = {normalize_session_name(name) for name in tmux}

    display: list[str] = sorted(tmux)
    display.extend(
        sorted(key for key in keys if normalize_session_name(key) not in normalized_tmux)
    )

    return display, mapping


def fzf_select(
    items: list[str],
    bottom: bool = False,
    full_screen: bool = False,
    bordered: bool = False,
) -> str:
    cmd: list[str] = [
        "fzf",
        "--prompt",
        "> ",
        "--height=100%" if full_screen else "--height=40%",
        "--exit-0",
    ]
    if bottom:
        cmd.append("--layout=default")
    else:
        cmd.append("--layout=reverse")

    if bordered:
        cmd.append("--border=top")

    p: Popen[str] = subprocess.Popen(
        cmd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        text=True,
    )

    stdout, _ = p.communicate("\n".join(items))
    return stdout.strip()


def normalize_session_name(name: str) -> str:
    return name.replace(".", "_")


def ensure_session(name: str, directory: Path) -> None:
    inside_tmux: bool = "TMUX" in os.environ
    session_name: str = normalize_session_name(name)
    target_name: str = f"={session_name}"

    if (
        subprocess.run(
            ["tmux", "has-session", "-t", target_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode
        != 0
    ):
        run(
            [
                "tmux",
                "new-session",
                "-ds",
                session_name,
                "-c",
                str(directory.expanduser().resolve()),
            ]
        )

    if inside_tmux:
        run(["tmux", "switch-client", "-t", target_name])
    else:
        run(["tmux", "attach-session", "-t", target_name])


def main() -> None:
    args = sys.argv[1:]
    bottom: bool = "--bottom" in args
    full_screen: bool = "--full-screen" in args
    bordered: bool = "--bordered" in args

    items, mapping = get_all_items(CONFIG)
    selected: str = fzf_select(items, bottom, full_screen, bordered)

    if not selected:
        return

    if selected in mapping:
        target = Path(mapping[selected]).expanduser().resolve()
    else:
        target = CONFIG.default_target.expanduser().resolve()

    ensure_session(selected, target)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
