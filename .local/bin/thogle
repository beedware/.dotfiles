#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import subprocess
import time
from dataclasses import asdict, dataclass
from pathlib import Path

GTK_START = time.monotonic()


@dataclass
class GtkPreferences:
    gtk_theme: str
    icon_theme: str
    font_name: str
    cursor_theme: str
    cursor_size: int
    toolbar_style: str
    toolbar_icons_size: str
    font_hinting: str
    font_antialiasing: str
    font_rgba_order: str
    text_scaling_factor: float
    color_scheme: str
    event_sounds: bool
    input_feedback_sounds: bool


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-r",
        "--rofi",
        action="store_true",
        help="Ask for confirmation in rofi instead of the shell",
    )
    return parser.parse_args()


def _confirm_with_shell(prompt: str) -> bool:
    answer = input(f"{prompt} [y/N] ")
    return answer.strip().lower() in {"y", "yes"}


def _confirm_with_rofi(prompt: str) -> bool:
    result = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", prompt],
        input="no\nyes\n",
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return False
    return result.stdout.strip().lower() == "yes"


def gtk_log(message: str) -> None:
    elapsed = int(time.monotonic() - GTK_START)
    print(f"INFO[{elapsed:04d}] {message}")


def run_gsettings(args: list[str]) -> str:
    result = subprocess.run(
        ["gsettings", *args],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "gsettings failed")
    return result.stdout.strip()


def parse_gsettings_value(raw: str) -> str:
    if raw.startswith("'") and raw.endswith("'"):
        return raw[1:-1]
    return raw


def load_gtk_preferences() -> GtkPreferences:
    keys = [
        "gtk-theme",
        "icon-theme",
        "font-name",
        "cursor-theme",
        "cursor-size",
        "toolbar-style",
        "toolbar-icons-size",
        "font-hinting",
        "font-antialiasing",
        "font-rgba-order",
        "text-scaling-factor",
    ]
    interface = {
        key: parse_gsettings_value(
            run_gsettings(["get", "org.gnome.desktop.interface", key])
        )
        for key in keys
    }
    sounds = {
        key: parse_gsettings_value(
            run_gsettings(["get", "org.gnome.desktop.sound", key])
        )
        for key in ["event-sounds", "input-feedback-sounds"]
    }
    return GtkPreferences(
        gtk_theme=interface["gtk-theme"],
        icon_theme=interface["icon-theme"],
        font_name=interface["font-name"],
        cursor_theme=interface["cursor-theme"],
        cursor_size=int(float(interface["cursor-size"])),
        toolbar_style=interface["toolbar-style"],
        toolbar_icons_size=interface["toolbar-icons-size"],
        font_hinting=interface["font-hinting"],
        font_antialiasing=interface["font-antialiasing"],
        font_rgba_order=interface["font-rgba-order"],
        text_scaling_factor=float(interface["text-scaling-factor"]),
        color_scheme="default",
        event_sounds=sounds["event-sounds"] == "true",
        input_feedback_sounds=sounds["input-feedback-sounds"] == "true",
    )


def gtk_profile(mode: str) -> tuple[str, str, str]:
    if mode == "dark":
        return "Yaru-blue-dark", "Papirus-Dark", "prefer-dark"
    if mode == "light":
        return "Yaru-blue", "Papirus-Light", "prefer-light"
    raise ValueError(f"Unsupported mode: {mode}")


def apply_gtk_profile(mode: str) -> GtkPreferences:
    gtk_theme, icon_theme, color_scheme = gtk_profile(mode)
    prefs = load_gtk_preferences()
    prefs.gtk_theme = gtk_theme
    prefs.icon_theme = icon_theme
    prefs.color_scheme = color_scheme
    return prefs


def gvariant_str(value: str) -> str:
    return "'" + value.replace("'", "\\'") + "'"


def gvariant_bool(value: bool) -> str:
    return "true" if value else "false"


def apply_gsettings_gtk(prefs: GtkPreferences) -> None:
    gtk_log(">>> Applying gsettings")
    interface = [
        ("gtk-theme", gvariant_str(prefs.gtk_theme)),
        ("icon-theme", gvariant_str(prefs.icon_theme)),
        ("cursor-theme", gvariant_str(prefs.cursor_theme)),
        ("cursor-size", str(prefs.cursor_size)),
        ("font-name", gvariant_str(prefs.font_name)),
        ("font-hinting", gvariant_str(prefs.font_hinting)),
        ("font-antialiasing", gvariant_str(prefs.font_antialiasing)),
        ("font-rgba-order", gvariant_str(prefs.font_rgba_order)),
        ("text-scaling-factor", str(prefs.text_scaling_factor)),
        ("toolbar-style", gvariant_str(prefs.toolbar_style)),
        ("toolbar-icons-size", gvariant_str(prefs.toolbar_icons_size)),
        ("color-scheme", gvariant_str(prefs.color_scheme)),
    ]
    gtk_log(">> org.gnome.desktop.interface")
    for key, value in interface:
        run_gsettings(["set", "org.gnome.desktop.interface", key, value])
    for key, value in [
        ("event-sounds", gvariant_bool(prefs.event_sounds)),
        ("input-feedback-sounds", gvariant_bool(prefs.input_feedback_sounds)),
    ]:
        run_gsettings(["set", "org.gnome.desktop.sound", key, value])


def gtk_bool_to_int(value: bool) -> int:
    return 1 if value else 0


def gtk_toolbar_style(style: str) -> str:
    return {
        "both-horiz": "GTK_TOOLBAR_BOTH_HORIZ",
        "both": "GTK_TOOLBAR_BOTH",
        "icons": "GTK_TOOLBAR_ICONS",
        "text": "GTK_TOOLBAR_TEXT",
    }.get(style, "GTK_TOOLBAR_ICONS")


def gtk_toolbar_icon_size(size: str) -> str:
    return {
        "small": "GTK_ICON_SIZE_SMALL_TOOLBAR",
        "large": "GTK_ICON_SIZE_LARGE_TOOLBAR",
    }.get(size, "GTK_ICON_SIZE_LARGE_TOOLBAR")


def xft_antialias(value: str) -> int:
    return 0 if value == "none" else 1


def xft_hinting(value: str) -> int:
    return 0 if value in {"none", ""} else 1


def xft_hintstyle(value: str) -> str:
    if value == "none":
        return "hintnone"
    return f"hint{value}"


def write_gtk_file(path: Path, lines: list[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")
    gtk_log(f">>> Exporting {path}")


def export_gtk_files(prefs: GtkPreferences) -> None:
    write_gtk_file(
        Path.home() / ".config/gtk-3.0/settings.ini",
        [
            "[Settings]",
            f"gtk-theme-name={prefs.gtk_theme}",
            f"gtk-icon-theme-name={prefs.icon_theme}",
            f"gtk-font-name={prefs.font_name}",
            f"gtk-cursor-theme-name={prefs.cursor_theme}",
            f"gtk-cursor-theme-size={prefs.cursor_size}",
            f"gtk-toolbar-style={gtk_toolbar_style(prefs.toolbar_style)}",
            f"gtk-toolbar-icon-size={gtk_toolbar_icon_size(prefs.toolbar_icons_size)}",
            "gtk-button-images=0",
            "gtk-menu-images=0",
            f"gtk-enable-event-sounds={gtk_bool_to_int(prefs.event_sounds)}",
            f"gtk-enable-input-feedback-sounds={gtk_bool_to_int(prefs.input_feedback_sounds)}",
            f"gtk-xft-antialias={xft_antialias(prefs.font_antialiasing)}",
            f"gtk-xft-hinting={xft_hinting(prefs.font_hinting)}",
            f"gtk-xft-hintstyle={xft_hintstyle(prefs.font_hinting)}",
            f"gtk-xft-rgba={prefs.font_rgba_order}",
            f"gtk-application-prefer-dark-theme={1 if prefs.color_scheme == 'prefer-dark' else 0}",
        ],
    )
    write_gtk_file(
        Path.home() / ".gtkrc-2.0",
        [
            "# DO NOT EDIT! This file will be overwritten by thogle.",
            "# Any customization should be done in ~/.gtkrc-2.0.mine instead.",
            "",
            f'include "{Path.home()}/.gtkrc-2.0.mine"',
            f'gtk-theme-name="{prefs.gtk_theme}"',
            f'gtk-icon-theme-name="{prefs.icon_theme}"',
            f'gtk-font-name="{prefs.font_name}"',
            f'gtk-cursor-theme-name="{prefs.cursor_theme}"',
            f"gtk-cursor-theme-size={prefs.cursor_size}",
            f"gtk-toolbar-style={gtk_toolbar_style(prefs.toolbar_style)}",
            f"gtk-toolbar-icon-size={gtk_toolbar_icon_size(prefs.toolbar_icons_size)}",
            "gtk-button-images=0",
            "gtk-menu-images=0",
            f"gtk-enable-event-sounds={gtk_bool_to_int(prefs.event_sounds)}",
            f"gtk-enable-input-feedback-sounds={gtk_bool_to_int(prefs.input_feedback_sounds)}",
            f"gtk-xft-antialias={xft_antialias(prefs.font_antialiasing)}",
            f"gtk-xft-hinting={xft_hinting(prefs.font_hinting)}",
            f'gtk-xft-hintstyle="{xft_hintstyle(prefs.font_hinting)}"',
            f'gtk-xft-rgba="{prefs.font_rgba_order}"',
        ],
    )
    write_gtk_file(
        Path.home() / ".icons/default/index.theme",
        [
            "# This file is written by thogle. Do not edit.",
            "[Icon Theme]",
            "Name=Default",
            "Comment=Default Cursor Theme",
            f"Inherits={prefs.cursor_theme}",
        ],
    )
    write_gtk_file(
        Path.home() / ".config/xsettingsd/xsettingsd.conf",
        [
            f'Net/ThemeName "{prefs.gtk_theme}"',
            f'Net/IconThemeName "{prefs.icon_theme}"',
            f'Gtk/CursorThemeName "{prefs.cursor_theme}"',
            f"Net/EnableEventSounds {gtk_bool_to_int(prefs.event_sounds)}",
            f"EnableInputFeedbackSounds {gtk_bool_to_int(prefs.input_feedback_sounds)}",
            f"Xft/Antialias {xft_antialias(prefs.font_antialiasing)}",
            f"Xft/Hinting {xft_hinting(prefs.font_hinting)}",
            f'Xft/HintStyle "{xft_hintstyle(prefs.font_hinting)}"',
            f'Xft/RGBA "{prefs.font_rgba_order}"',
        ],
    )
    write_gtk_file(
        Path.home() / ".config/gtk-4.0/settings.ini",
        [
            "[Settings]",
            f"gtk-theme-name={prefs.gtk_theme}",
            f"gtk-icon-theme-name={prefs.icon_theme}",
            f"gtk-font-name={prefs.font_name}",
            f"gtk-application-prefer-dark-theme={1 if prefs.color_scheme == 'prefer-dark' else 0}",
        ],
    )


def symlink_gtk4_css(prefs: GtkPreferences) -> None:
    source = Path("/usr/share/themes") / prefs.gtk_theme / "gtk-4.0"
    target = Path.home() / ".config/gtk-4.0"
    target.mkdir(parents=True, exist_ok=True)
    for file_name in ["gtk.css", "gtk-dark.css"]:
        dst = target / file_name
        src = source / file_name
        if dst.exists() or dst.is_symlink():
            dst.unlink()
        if src.exists():
            dst.symlink_to(src)
    gtk_log(f">>> Symlinking files in {target}")


def backup_gtk_prefs(prefs: GtkPreferences) -> None:
    backup_dir = Path.home() / ".local/share/nwg-look"
    backup_dir.mkdir(parents=True, exist_ok=True)
    (backup_dir / "gsettings.json").write_text(json.dumps(asdict(prefs), indent=2) + "\n")
    gtk_log(f">>> Backing up gsettings to {backup_dir}")


def log_gtk_prefs(prefs: GtkPreferences) -> None:
    gtk_log(f"lang: {os.environ.get('LANG', 'en_US')}")
    gtk_log(f"gtk-theme: {prefs.gtk_theme}")
    gtk_log(f"icon-theme: {prefs.icon_theme}")
    gtk_log(f"font-name: {prefs.font_name}")
    gtk_log(f"cursor-theme: {prefs.cursor_theme}")
    gtk_log(f"cursor-size: {prefs.cursor_size}")
    gtk_log(f"toolbar-style: {prefs.toolbar_style}")
    gtk_log(f"toolbar-icons-size: {prefs.toolbar_icons_size}")
    gtk_log(f"font-hinting: {prefs.font_hinting}")
    gtk_log(f"font-antialiasing: {prefs.font_antialiasing}")
    gtk_log(f"font-rgba-order: {prefs.font_rgba_order}")
    gtk_log(f"text-scaling-factor: {prefs.text_scaling_factor:g}")
    gtk_log(f"color-scheme: {prefs.color_scheme}")
    gtk_log(f"event-sounds: {str(prefs.event_sounds).lower()}")
    gtk_log(
        f"input-feedback-sounds: {str(prefs.input_feedback_sounds).lower()}"
    )


def toggle_gtk(mode: str) -> None:
    gtk_log(">>> Loading preferences")
    gtk_log(">>> Reading gsettings")
    prefs = apply_gtk_profile(mode)
    log_gtk_prefs(prefs)
    gtk_log(">>> Parsing original ~/.config/gtk-3.0/settings.ini")
    apply_gsettings_gtk(prefs)
    backup_gtk_prefs(prefs)
    export_gtk_files(prefs)
    symlink_gtk4_css(prefs)


def _toggle_mapping(
    text: str,
    light_to_dark: dict[str, str],
    detect_light: str,
) -> tuple[dict[str, str], str, str]:
    if detect_light in text:
        return light_to_dark, "light", "dark"
    return {value: key for key, value in light_to_dark.items()}, "dark", "light"


def _replace_all(text: str, mapping: dict[str, str]) -> str:
    updated = text
    for src, dst in mapping.items():
        updated = updated.replace(src, dst)
    return updated


def toggle_config(
    path: Path,
    light_to_dark: dict[str, str],
    detect_light: str,
) -> tuple[str, str]:
    text = path.read_text()
    mapping, old_mode, new_mode = _toggle_mapping(text, light_to_dark, detect_light)
    path.write_text(_replace_all(text, mapping))
    print(f"{path}: {old_mode} => {new_mode}")
    return old_mode, new_mode


def run_text_toggle(path: Path, light_to_dark: dict[str, str]) -> str:
    _, new_mode = toggle_config(path, light_to_dark, next(iter(light_to_dark)))
    return new_mode


def _toggle_copy_theme(target_path: Path, light_path: Path, dark_path: Path, detect_light: str) -> None:
    current = target_path.read_text()
    if detect_light in current:
        src, old_mode, new_mode = dark_path, "light", "dark"
    else:
        src, old_mode, new_mode = light_path, "dark", "light"
    shutil.copyfile(src, target_path)
    print(f"{target_path}: {old_mode} => {new_mode}")


def toggle_bashrc() -> str:
    return run_text_toggle(
        Path.home() / ".bashrc",
        {
            "fzf/themes/light.sh": "fzf/themes/dark.sh",
            "--theme=Light": "--theme=Dark",
        },
    )


def toggle_alacritty() -> None:
    run_text_toggle(
        Path.home() / ".config/alacritty/alacritty.toml",
        {"themes/light.toml": "themes/dark.toml"},
    )


def toggle_dunst() -> None:
    dunst_dir = Path.home() / ".config/dunst"
    _toggle_copy_theme(
        dunst_dir / "dunstrc",
        dunst_dir / "themes/light.conf",
        dunst_dir / "themes/dark.conf",
        "theme: light",
    )
    subprocess.run(["killall", "dunst"], check=False)


def toggle_i3() -> None:
    run_text_toggle(
        Path.home() / ".config/i3/config",
        {"themes/light.conf": "themes/dark.conf"},
    )
    subprocess.run(["i3-msg", "reload"], check=False)


def _toggle_marker_theme(target_path: Path, light_path: Path, dark_path: Path) -> None:
    current = target_path.read_text()
    lines = current.splitlines(keepends=True)
    theme_line = next(
        (
            index
            for index, line in enumerate(lines)
            if line.strip() in {"# Light", "# Dark"}
        ),
        None,
    )
    if theme_line is None:
        raise RuntimeError(f"Could not find theme marker in {target_path}")

    shared = "".join(lines[:theme_line])
    current_theme = lines[theme_line].strip()
    if current_theme == "# Light":
        theme = dark_path.read_text()
        old_mode, new_mode = "light", "dark"
    else:
        theme = light_path.read_text()
        old_mode, new_mode = "dark", "light"
    target_path.write_text(shared + theme)
    print(f"{target_path}: {old_mode} => {new_mode}")


def toggle_zathura() -> None:
    zathura_dir = Path.home() / ".config/zathura"
    _toggle_marker_theme(
        zathura_dir / "zathurarc",
        zathura_dir / "themes/light.zathurarc",
        zathura_dir / "themes/dark.zathurarc",
    )


def toggle_tmux() -> None:
    tmux_dir = Path.home() / ".config/tmux"
    _toggle_marker_theme(
        tmux_dir / "tmux.conf",
        tmux_dir / "themes/light.conf",
        tmux_dir / "themes/dark.conf",
    )


def toggle_rofi() -> None:
    run_text_toggle(
        Path.home() / ".config/rofi/config.rasi",
        {'@import "themes/light"': '@import "themes/dark"'},
    )


def toggle_nvim() -> None:
    run_text_toggle(
        Path.home() / ".config/nvim/init.lua",
        {'vim.o.background = "light"': 'vim.o.background = "dark"'},
    )


def toggle_emacs() -> None:
    run_text_toggle(
        Path.home() / ".config/emacs/lisp/ui-rc.el",
        {"(load-theme 'modus-operandi t)": "(load-theme 'modus-vivendi t)"},
    )


def restart_emacs_daemon() -> None:
    subprocess.run(["killall", "emacs"], check=False)
    subprocess.run(["emacs", "--daemon"], check=True)
    print("Emacs default daemon restarted")


def toggle_opencode(mode: str) -> None:
    _toggle_json_key(Path.home() / ".config/opencode/tui.json", "theme", mode)


def close_calibre() -> None:
    closed = False
    for process_name in ["calibre", "calibre-gui", "ebook-viewer"]:
        result = subprocess.run(
            ["killall", process_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            closed = True
    if closed:
        print("Closed running Calibre processes")


def read_json_or_empty(path: Path) -> dict:
    if not path.exists():
        return {}
    text = path.read_text().strip()
    if not text:
        return {}
    return json.loads(text)


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def _toggle_json_key(path: Path, key: str, mode: str) -> None:
    data = read_json_or_empty(path)
    keys = key.split(".")
    target = data
    for k in keys[:-1]:
        target = target.setdefault(k, {})
    old = target.get(keys[-1], "<unset>")
    target[keys[-1]] = mode
    write_json(path, data)
    print(f"{path}: {old} => {mode}")


def toggle_calibre(mode: str) -> None:
    close_calibre()
    calibre_dir = Path.home() / ".config/calibre"
    _toggle_json_key(calibre_dir / "gui.json", "color_palette", mode)
    _toggle_json_key(calibre_dir / "viewer-webengine.json", "session_data.current_color_scheme", mode)


def set_wallpaper(mode: str) -> None:
    wallpaper_dir = Path.home() / ".config/wallpaper"
    wallpaper = wallpaper_dir / "themes" / f"{mode}.jpg"
    shutil.copyfile(wallpaper, wallpaper_dir / "current.jpg")
    script = Path.home() / ".screenlayout/screens.sh"
    subprocess.run([str(script)], check=True)
    print(f"{wallpaper_dir / 'current.jpg'}: {mode}")


def reset_terminal_sessions() -> None:
    subprocess.run(["killall", "alacritty"], check=False)
    subprocess.run(["tmux", "kill-server"], check=False)
    print("Reset terminal sessions: killed alacritty and tmux server")


def main() -> None:
    args = _parse_args()
    confirm = _confirm_with_rofi if args.rofi else _confirm_with_shell
    if not confirm("Run thogle?"):
        print("Cancelled")
        return
    mode = toggle_bashrc()
    toggle_alacritty()
    toggle_dunst()
    toggle_i3()
    toggle_zathura()
    toggle_tmux()
    toggle_rofi()
    toggle_nvim()
    toggle_emacs()
    restart_emacs_daemon()
    toggle_opencode(mode)
    toggle_calibre(mode)
    set_wallpaper(mode)
    toggle_gtk(mode)
    reset_terminal_sessions()


if __name__ == "__main__":
    main()
