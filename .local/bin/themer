#!/usr/bin/env python3
import argparse
import json
import shutil
import subprocess
from dataclasses import asdict, dataclass
from enum import StrEnum
from pathlib import Path


class Mode(StrEnum):
    LIGHT = "light"
    DARK = "dark"

    def toggle(self) -> "Mode":
        return Mode.DARK if self is Mode.LIGHT else Mode.LIGHT


class FileTheme:
    def __init__(self, src: str | Path, dist_file: str | Path) -> None:
        self.src = Path(src).expanduser()
        self.dist_file = Path(dist_file).expanduser()

    def set(self, mode: Mode) -> None:
        source = self.src / f"{mode.value}{self.dist_file.suffix}"
        destination = self.src / self.dist_file
        shutil.copyfile(source, destination)


class CalibreTheme:
    def __init__(self, path: str | Path) -> None:
        self.path = Path(path).expanduser()

    def set(self, mode: Mode) -> None:
        self._close_processes()
        self._set_gui_theme(mode)
        self._set_viewer_theme(mode)

    @staticmethod
    def _close_processes() -> None:
        for process_name in ["calibre", "calibre-gui", "ebook-viewer"]:
            subprocess.run(
                ["killall", process_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

    def _set_gui_theme(self, mode: Mode) -> None:
        data = self._read_config("gui.json")
        data["color_palette"] = mode.value
        self._write_config("gui.json", data)

    def _set_viewer_theme(self, mode: Mode) -> None:
        data = self._read_config("viewer-webengine.json")
        session = data.setdefault("session_data", {})
        session["current_color_scheme"] = mode.value
        self._write_config("viewer-webengine.json", data)

    def _read_config(self, filename: str) -> dict:
        path = self.path / filename
        try:
            text = path.read_text(encoding="utf-8").strip()
        except FileNotFoundError:
            return {}
        return json.loads(text) if text else {}

    def _write_config(self, filename: str, data: dict) -> None:
        self.path.mkdir(parents=True, exist_ok=True)
        path = self.path / filename
        path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


@dataclass
class GtkPreferences:
    gtk_theme: str
    icon_theme: str
    font_name: str
    cursor_theme: str
    cursor_size: int
    toolbar_style: str
    toolbar_icons_size: str
    font_hinting: str
    font_antialiasing: str
    font_rgba_order: str
    text_scaling_factor: float
    color_scheme: str
    event_sounds: bool
    input_feedback_sounds: bool


class GtkTheme:
    def __init__(
        self,
        home: str | Path | None = None,
        themes: str | Path = "/usr/share/themes",
    ) -> None:
        self.home = Path(home).expanduser() if home is not None else Path.home()
        self.themes = Path(themes).expanduser()

    def set(self, mode: Mode) -> None:
        prefs = self._load_preferences()
        if mode == Mode.DARK:
            prefs.gtk_theme = "Yaru-blue-dark"
            prefs.icon_theme = "Papirus-Dark"
            prefs.color_scheme = "prefer-dark"
        elif mode == Mode.LIGHT:
            prefs.gtk_theme = "Yaru-blue"
            prefs.icon_theme = "Papirus-Light"
            prefs.color_scheme = "prefer-light"
        self._apply_gsettings(prefs)
        self._backup_preferences(prefs)
        self._export_files(prefs)
        self._symlink_gtk4_css(prefs)

    @staticmethod
    def _run_gsettings(args: list[str]) -> str:
        result = subprocess.run(
            ["gsettings", *args],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip() or "gsettings failed")
        return result.stdout.strip()

    def _get_setting(self, schema: str, key: str) -> str:
        raw = self._run_gsettings(["get", schema, key])
        if raw.startswith("'") and raw.endswith("'"):
            return raw[1:-1]
        return raw

    def _load_preferences(self) -> GtkPreferences:
        interface = {
            key: self._get_setting("org.gnome.desktop.interface", key)
            for key in [
                "gtk-theme",
                "icon-theme",
                "font-name",
                "cursor-theme",
                "cursor-size",
                "toolbar-style",
                "toolbar-icons-size",
                "font-hinting",
                "font-antialiasing",
                "font-rgba-order",
                "text-scaling-factor",
            ]
        }
        sounds = {
            key: self._get_setting("org.gnome.desktop.sound", key)
            for key in ["event-sounds", "input-feedback-sounds"]
        }
        return GtkPreferences(
            gtk_theme=interface["gtk-theme"],
            icon_theme=interface["icon-theme"],
            font_name=interface["font-name"],
            cursor_theme=interface["cursor-theme"],
            cursor_size=int(float(interface["cursor-size"])),
            toolbar_style=interface["toolbar-style"],
            toolbar_icons_size=interface["toolbar-icons-size"],
            font_hinting=interface["font-hinting"],
            font_antialiasing=interface["font-antialiasing"],
            font_rgba_order=interface["font-rgba-order"],
            text_scaling_factor=float(interface["text-scaling-factor"]),
            color_scheme="default",
            event_sounds=sounds["event-sounds"] == "true",
            input_feedback_sounds=sounds["input-feedback-sounds"] == "true",
        )

    @staticmethod
    def _gvariant_str(value: str) -> str:
        return "'" + value.replace("'", "\\'") + "'"

    def _apply_gsettings(self, prefs: GtkPreferences) -> None:
        interface = [
            ("gtk-theme", self._gvariant_str(prefs.gtk_theme)),
            ("icon-theme", self._gvariant_str(prefs.icon_theme)),
            ("cursor-theme", self._gvariant_str(prefs.cursor_theme)),
            ("cursor-size", str(prefs.cursor_size)),
            ("font-name", self._gvariant_str(prefs.font_name)),
            ("font-hinting", self._gvariant_str(prefs.font_hinting)),
            ("font-antialiasing", self._gvariant_str(prefs.font_antialiasing)),
            ("font-rgba-order", self._gvariant_str(prefs.font_rgba_order)),
            ("text-scaling-factor", str(prefs.text_scaling_factor)),
            ("toolbar-style", self._gvariant_str(prefs.toolbar_style)),
            ("toolbar-icons-size", self._gvariant_str(prefs.toolbar_icons_size)),
            ("color-scheme", self._gvariant_str(prefs.color_scheme)),
        ]
        for key, value in interface:
            self._run_gsettings(["set", "org.gnome.desktop.interface", key, value])
        for key, value in [
            ("event-sounds", prefs.event_sounds),
            ("input-feedback-sounds", prefs.input_feedback_sounds),
        ]:
            self._run_gsettings(
                ["set", "org.gnome.desktop.sound", key, str(value).lower()]
            )

    @staticmethod
    def _toolbar_style(style: str) -> str:
        return {
            "both-horiz": "GTK_TOOLBAR_BOTH_HORIZ",
            "both": "GTK_TOOLBAR_BOTH",
            "icons": "GTK_TOOLBAR_ICONS",
            "text": "GTK_TOOLBAR_TEXT",
        }.get(style, "GTK_TOOLBAR_ICONS")

    @staticmethod
    def _toolbar_icon_size(size: str) -> str:
        return {
            "small": "GTK_ICON_SIZE_SMALL_TOOLBAR",
            "large": "GTK_ICON_SIZE_LARGE_TOOLBAR",
        }.get(size, "GTK_ICON_SIZE_LARGE_TOOLBAR")

    @staticmethod
    def _write_file(path: Path, lines: list[str]) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")

    def _export_files(self, prefs: GtkPreferences) -> None:
        toolbar_style = self._toolbar_style(prefs.toolbar_style)
        toolbar_icon_size = self._toolbar_icon_size(prefs.toolbar_icons_size)
        antialias = int(prefs.font_antialiasing != "none")
        hinting = int(prefs.font_hinting not in {"none", ""})
        hintstyle = (
            "hintnone" if prefs.font_hinting == "none" else f"hint{prefs.font_hinting}"
        )
        prefer_dark = int(prefs.color_scheme == "prefer-dark")
        self._write_file(
            self.home / ".config/gtk-3.0/settings.ini",
            [
                "[Settings]",
                f"gtk-theme-name={prefs.gtk_theme}",
                f"gtk-icon-theme-name={prefs.icon_theme}",
                f"gtk-font-name={prefs.font_name}",
                f"gtk-cursor-theme-name={prefs.cursor_theme}",
                f"gtk-cursor-theme-size={prefs.cursor_size}",
                f"gtk-toolbar-style={toolbar_style}",
                f"gtk-toolbar-icon-size={toolbar_icon_size}",
                "gtk-button-images=0",
                "gtk-menu-images=0",
                f"gtk-enable-event-sounds={int(prefs.event_sounds)}",
                f"gtk-enable-input-feedback-sounds={int(prefs.input_feedback_sounds)}",
                f"gtk-xft-antialias={antialias}",
                f"gtk-xft-hinting={hinting}",
                f"gtk-xft-hintstyle={hintstyle}",
                f"gtk-xft-rgba={prefs.font_rgba_order}",
                f"gtk-application-prefer-dark-theme={prefer_dark}",
            ],
        )
        self._write_file(
            self.home / ".gtkrc-2.0",
            [
                "# DO NOT EDIT! This file will be overwritten by themer.",
                "# Any customization should be done in ~/.gtkrc-2.0.mine instead.",
                "",
                f'include "{self.home}/.gtkrc-2.0.mine"',
                f'gtk-theme-name="{prefs.gtk_theme}"',
                f'gtk-icon-theme-name="{prefs.icon_theme}"',
                f'gtk-font-name="{prefs.font_name}"',
                f'gtk-cursor-theme-name="{prefs.cursor_theme}"',
                f"gtk-cursor-theme-size={prefs.cursor_size}",
                f"gtk-toolbar-style={toolbar_style}",
                f"gtk-toolbar-icon-size={toolbar_icon_size}",
                "gtk-button-images=0",
                "gtk-menu-images=0",
                f"gtk-enable-event-sounds={int(prefs.event_sounds)}",
                f"gtk-enable-input-feedback-sounds={int(prefs.input_feedback_sounds)}",
                f"gtk-xft-antialias={antialias}",
                f"gtk-xft-hinting={hinting}",
                f'gtk-xft-hintstyle="{hintstyle}"',
                f'gtk-xft-rgba="{prefs.font_rgba_order}"',
            ],
        )
        self._write_file(
            self.home / ".icons/default/index.theme",
            [
                "# This file is written by themer. Do not edit.",
                "[Icon Theme]",
                "Name=Default",
                "Comment=Default Cursor Theme",
                f"Inherits={prefs.cursor_theme}",
            ],
        )
        self._write_file(
            self.home / ".config/xsettingsd/xsettingsd.conf",
            [
                f'Net/ThemeName "{prefs.gtk_theme}"',
                f'Net/IconThemeName "{prefs.icon_theme}"',
                f'Gtk/CursorThemeName "{prefs.cursor_theme}"',
                f"Net/EnableEventSounds {int(prefs.event_sounds)}",
                f"EnableInputFeedbackSounds {int(prefs.input_feedback_sounds)}",
                f"Xft/Antialias {antialias}",
                f"Xft/Hinting {hinting}",
                f'Xft/HintStyle "{hintstyle}"',
                f'Xft/RGBA "{prefs.font_rgba_order}"',
            ],
        )
        self._write_file(
            self.home / ".config/gtk-4.0/settings.ini",
            [
                "[Settings]",
                f"gtk-theme-name={prefs.gtk_theme}",
                f"gtk-icon-theme-name={prefs.icon_theme}",
                f"gtk-font-name={prefs.font_name}",
                f"gtk-application-prefer-dark-theme={prefer_dark}",
            ],
        )

    def _symlink_gtk4_css(self, prefs: GtkPreferences) -> None:
        source = self.themes / prefs.gtk_theme / "gtk-4.0"
        target = self.home / ".config/gtk-4.0"
        target.mkdir(parents=True, exist_ok=True)
        for filename in ["gtk.css", "gtk-dark.css"]:
            destination = target / filename
            src = source / filename
            if destination.exists() or destination.is_symlink():
                destination.unlink()
            if src.exists():
                destination.symlink_to(src)

    def _backup_preferences(self, prefs: GtkPreferences) -> None:
        self._write_file(
            self.home / ".local/share/nwg-look/gsettings.json",
            [json.dumps(asdict(prefs), indent=2)],
        )


class ScreenLayout:
    def __init__(self, path: str | Path) -> None:
        self.path = Path(path).expanduser()
        self.script = self.path / "screens.sh"

    def setup(self, cli: "CLI") -> bool:
        if self.script.is_file():
            return True
        scripts = sorted(
            path
            for path in self.path.glob("*.sh")
            if path.name != self.script.name and path.is_file()
        )
        if not scripts:
            raise RuntimeError(f"No screen layout scripts found in {self.path}")
        selected = cli.choose("Choose a screen layout", [path.name for path in scripts])
        if selected is None:
            return False
        shutil.copy2(self.path / selected, self.script)
        self.script.chmod(self.script.stat().st_mode | 0o100)
        return True

    def apply(self) -> None:
        subprocess.run([str(self.script)], check=True)


class Themer:
    def __init__(self, path: Path | None = None) -> None:
        self.path = path if path is not None else Path.home() / ".config/themer/mode"

    def get_mode(self) -> Mode:
        try:
            value = self.path.read_text(encoding="utf-8").strip()
        except FileNotFoundError:
            self.set_mode(Mode.DARK)
            return Mode.DARK
        return Mode(value)

    def set_mode(self, mode: Mode) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.path.write_text(f"{mode.value}\n", encoding="utf-8")


class CLI:
    def __init__(self, description: str | None = None) -> None:
        self.parser = argparse.ArgumentParser(description=description)
        self.parser.add_argument(
            "-t",
            "--theme",
            type=Mode,
            choices=list(Mode),
            help="Set the theme instead of toggling it",
        )
        self.parser.add_argument(
            "-r",
            "--rofi",
            action="store_true",
            help="Ask for confirmation in rofi instead of the shell",
        )
        self.parser.add_argument(
            "-y",
            "--yes",
            action="store_true",
            help="Skip confirmation and assume yes",
        )
        self.args = argparse.Namespace(rofi=False, theme=None, yes=False)

    def parse_args(self, argv: list[str] | None = None) -> argparse.Namespace:
        self.args = self.parser.parse_args(argv)
        return self.args

    @staticmethod
    def _shell_confirm(prompt: str) -> bool:
        answer = input(f"{prompt} [y/N] ")
        return answer.strip().lower() in {"y", "yes"}

    @staticmethod
    def _rofi_confirm(prompt: str) -> bool:
        result = subprocess.run(
            ["rofi", "-dmenu", "-i", "-p", prompt],
            input="no\nyes\n",
            text=True,
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            return False
        return result.stdout.strip().lower() == "yes"

    def confirm(self, prompt: str) -> bool:
        if self.args.yes:
            return True
        if self.args.rofi:
            return self._rofi_confirm(prompt)
        return self._shell_confirm(prompt)

    def choose(self, prompt: str, options: list[str]) -> str | None:
        if self.args.rofi:
            result = subprocess.run(
                ["rofi", "-dmenu", "-i", "-p", prompt],
                input="\n".join(options) + "\n",
                text=True,
                capture_output=True,
                check=False,
            )
            selected = result.stdout.strip()
            if result.returncode != 0 or selected not in options:
                return None
            return selected

        print(prompt)
        for index, option in enumerate(options, start=1):
            print(f"  {index}. {option}")
        while True:
            try:
                answer = input("Select a number (Enter to cancel): ").strip()
            except EOFError:
                return None
            if not answer:
                return None
            if answer.isdecimal() and 1 <= int(answer) <= len(options):
                return options[int(answer) - 1]
            print(f"Choose a number between 1 and {len(options)}.")


def main() -> None:
    cli: CLI = CLI(description="Toggle application themes")
    args: argparse.Namespace = cli.parse_args()
    prompt: str = (
        f"Change to {args.theme} theme?" if args.theme is not None else "Toggle theme?"
    )
    if not cli.confirm(prompt):
        return
    themer: Themer = Themer()
    mode: Mode = themer.get_mode().toggle()
    if args.theme:
        mode = args.theme

    home: Path = Path.home()
    config: Path = home / ".config"
    screen_layout = ScreenLayout(home / ".screenlayout")
    if not screen_layout.setup(cli):
        return

    FileTheme(config / "alacritty", "theme.toml").set(mode)
    FileTheme(config / "dunst", "dunstrc").set(mode)
    FileTheme(config / "i3", "theme.conf").set(mode)
    FileTheme(config / "zathura", "zathurarc").set(mode)
    FileTheme(config / "rofi", "theme.rasi").set(mode)
    FileTheme(config / "opencode" / "themes", "modus.json").set(mode)
    FileTheme(config / "tmux", "theme.conf").set(mode)
    FileTheme(config / "wallpaper", "theme.jpg").set(mode)

    CalibreTheme(config / "calibre").set(mode)
    GtkTheme(home).set(mode)

    themer.set_mode(mode)
    screen_layout.apply()
    subprocess.run(["dunstctl", "reload"], check=False)
    subprocess.run(["i3-msg", "reload"], check=False)
    subprocess.run(["killall", "emacs"], check=False)
    subprocess.run(["emacs", "--daemon"], check=True)
    subprocess.run(["tmux", "kill-server"], check=False)
    subprocess.run(["killall", "alacritty"], check=False)


if __name__ == "__main__":
    main()
