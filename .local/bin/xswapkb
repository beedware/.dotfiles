#!/bin/sh

LAYOUT_1="gb"
LAYOUT_2="ara"

CURRENT_LAYOUT=$(setxkbmap -query | grep layout | awk '{print $2}')

if [ "$CURRENT_LAYOUT" = "$LAYOUT_1" ]; then
    NEW_LAYOUT="$LAYOUT_2"
else
    NEW_LAYOUT="$LAYOUT_1"
fi

setxkbmap "$NEW_LAYOUT"
notify-send "Keyboard layout" "Switched to $NEW_LAYOUT"

pkill -SIGRTMIN+10 dwmblocks
pkill -SIGRTMIN+10 i3blocks
