#!/usr/bin/env python3

from __future__ import annotations

import argparse
import curses
import os
import re
import select
import subprocess
import sys
import termios
import tty
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from subprocess import CompletedProcess


@dataclass(frozen=True)
class AppConfig:
    prompt: str
    exit_signal: str
    src_dir: Path


CONFIG = AppConfig(
    prompt="Name: ",
    exit_signal="__ESC_EXIT__",
    src_dir=Path.home() / "Projects",
)

GIT_URL_RE = re.compile(r"^(https?://|git@[^:]+:|ssh://git@[^/]+/|gh:)")
REPO_CLEAN_PATTERNS: Sequence[tuple[str, str]] = (
    (r"^ssh://git@[^/]+/", ""),
    (r"^git@[^:]+:", ""),
    (r"^https?://[^/]+/", ""),
    (r"(\.git)?$", ""),
)


def is_esc(ch: int) -> bool:
    return ch in (27, curses.KEY_EXIT)


def move_left(pos: int) -> int:
    return max(0, pos - 1)


def move_right(pos: int, buf_len: int) -> int:
    return min(buf_len, pos + 1)


def backspace(buf: list[str], pos: int) -> int:
    if pos > 0:
        del buf[pos - 1]
        return pos - 1
    return pos


def delete(buf: list[str], pos: int) -> int:
    if pos < len(buf):
        del buf[pos]
    return pos


def insert_char(buf: list[str], pos: int, ch: int) -> int:
    if 32 <= ch <= 126:
        buf.insert(pos, chr(ch))
        return pos + 1
    return pos


def render_line(
    stdscr,
    prompt: str,
    buf: list[str],
    pos: int,
    error_message: str = "",
    bordered: bool = False,
) -> None:
    height, width = stdscr.getmaxyx()

    row = 1 if bordered else 0
    error_row = 2 if bordered else 1

    if bordered:
        stdscr.move(0, 0)
        stdscr.clrtoeol()
        try:
            stdscr.addstr(0, 0, "─" * width)
        except curses.error:
            pass

    stdscr.move(row, 0)
    stdscr.clrtoeol()

    try:
        stdscr.addstr(row, 0, f"{prompt}{''.join(buf)}")
    except curses.error:
        pass

    if height > error_row:
        stdscr.move(error_row, 0)
        stdscr.clrtoeol()
        if error_message:
            try:
                stdscr.addstr(error_row, 0, error_message)
            except curses.error:
                pass

    stdscr.move(row, len(prompt) + pos)
    stdscr.refresh()


def handle_key(
    ch: int,
    buf: list[str],
    pos: int,
) -> tuple[list[str], int, bool]:
    if is_esc(ch):
        return buf, pos, True

    if ch in (10, 13):
        return buf, pos, True

    if ch == curses.KEY_LEFT:
        return buf, move_left(pos), False

    if ch == curses.KEY_RIGHT:
        return buf, move_right(pos, len(buf)), False

    if ch in (curses.KEY_BACKSPACE, 127):
        return buf, backspace(buf, pos), False

    if ch == curses.KEY_DC:
        return buf, delete(buf, pos), False

    return buf, insert_char(buf, pos, ch), False


def curses_loop(
    stdscr,
    prompt: str,
    initial_value: str = "",
    error_message: str = "",
    bordered: bool = False,
) -> str:
    curses.set_escdelay(25)
    curses.curs_set(1)
    curses.start_color()
    curses.use_default_colors()

    stdscr.keypad(True)
    stdscr.bkgd(" ", curses.A_NORMAL)

    buf: list[str] = list(initial_value)
    pos = len(buf)
    render_line(stdscr, prompt, buf, pos, error_message, bordered)

    while True:
        ch = stdscr.getch()

        buf, pos, done = handle_key(ch, buf, pos)

        render_line(stdscr, prompt, buf, pos, error_message, bordered)

        if done:
            if is_esc(ch):
                return CONFIG.exit_signal
            return "".join(buf)


def curses_input(
    prompt: str,
    initial_value: str = "",
    error_message: str = "",
    bordered: bool = False,
) -> str:
    return curses.wrapper(curses_loop, prompt, initial_value, error_message, bordered)


def line_input(
    prompt: str,
    initial_value: str = "",
    error_message: str = "",
) -> str:
    if error_message:
        print(error_message)

    buf: list[str] = list(initial_value)
    pos = len(buf)
    stdin_fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(stdin_fd)

    def redraw() -> None:
        sys.stdout.write(f"\r\x1b[K{prompt}{''.join(buf)}")
        sys.stdout.write(f"\r\x1b[{len(prompt) + pos}C")
        sys.stdout.flush()

    def read_char() -> str:
        return os.read(stdin_fd, 1).decode(errors="ignore")

    def read_next(timeout: float = 0.5) -> str | None:
        ready, _, _ = select.select([stdin_fd], [], [], timeout)
        if not ready:
            return None
        return read_char()

    def read_escape_sequence() -> str | None:
        first = read_next()
        if first is None:
            return None

        seq = first
        while len(seq) < 4:
            char = read_next(0.02)
            if char is None:
                break
            seq += char
        return seq

    try:
        tty.setraw(stdin_fd)
        redraw()

        while True:
            ch = read_char()

            if ch in ("\r", "\n"):
                sys.stdout.write("\r\n")
                sys.stdout.flush()
                return "".join(buf)

            if ch == "\x03":
                sys.stdout.write("\r\n")
                sys.stdout.flush()
                return CONFIG.exit_signal

            if ch == "\x04" and not buf:
                sys.stdout.write("\r\n")
                sys.stdout.flush()
                return CONFIG.exit_signal

            if ch == "\x1b":
                seq = read_escape_sequence()
                if seq is None:
                    sys.stdout.write("\r\n")
                    sys.stdout.flush()
                    return CONFIG.exit_signal

                if seq in ("[D", "OD"):
                    pos = move_left(pos)
                elif seq in ("[C", "OC"):
                    pos = move_right(pos, len(buf))
                elif seq in ("[H", "OH"):
                    pos = 0
                elif seq in ("[F", "OF"):
                    pos = len(buf)
                elif seq == "[3~":
                    pos = delete(buf, pos)

                redraw()
                continue

            if ch in ("\x7f", "\b"):
                pos = backspace(buf, pos)
            elif ch == "\x01":
                pos = 0
            elif ch == "\x05":
                pos = len(buf)
            else:
                pos = insert_char(buf, pos, ord(ch))

            redraw()
    finally:
        termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_settings)


def prompt_input(
    prompt: str,
    initial_value: str = "",
    error_message: str = "",
) -> str:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--full-screen", action="store_true")
    parser.add_argument("--full-screen-bordered", action="store_true")
    args, _ = parser.parse_known_args()
    full_screen = args.full_screen or args.full_screen_bordered
    if full_screen:
        return curses_input(prompt, initial_value, error_message, args.full_screen_bordered)
    return line_input(prompt, initial_value, error_message)


def run(cmd: list[str], check: bool = True) -> CompletedProcess[bytes]:
    return subprocess.run(cmd, check=check)


def ensure_src_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def has_session(name: str) -> bool:
    result = subprocess.run(
        ["tmux", "has-session", "-t", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def ensure_session(name: str, directory: Path | None = None) -> None:
    inside_tmux = "TMUX" in os.environ

    if not has_session(name):
        cmd = ["tmux", "new-session", "-ds", name]
        if directory:
            cmd += ["-c", str(directory)]
        run(cmd)

    if inside_tmux:
        run(["tmux", "switch-client", "-t", name])
    else:
        run(["tmux", "attach-session", "-t", name])


def is_git_url(value: str) -> bool:
    return bool(GIT_URL_RE.match(value))


def clean_repo_path(url: str) -> str:
    cleaned = url
    for pattern, replacement in REPO_CLEAN_PATTERNS:
        cleaned = re.sub(pattern, replacement, cleaned)
    return cleaned


def is_tmp_path(value: str) -> bool:
    return value.startswith("tmp/")


def tmp_target_dir(value: str) -> Path | None:
    relative = value[len("tmp/") :].strip("/")
    if not relative:
        return None
    return Path("/tmp") / relative


def is_share_path(value: str) -> bool:
    return value.startswith("share/")


def share_target_dir(value: str) -> Path | None:
    relative = value[len("share/") :].strip("/")
    if not relative:
        return None
    return Path.home() / ".local" / "share" / relative


def handle_share_path(value: str) -> str | None:
    current_value = value

    while True:
        share_dir = share_target_dir(current_value)
        if share_dir is not None and share_dir.is_dir():
            ensure_session(normalize_session_name(current_value), share_dir)
            return None

        current_value = prompt_input(
            CONFIG.prompt,
            current_value,
            "Path not found in ~/.local/share; fix and retry.",
        ).strip()

        if current_value == CONFIG.exit_signal:
            return None

        if not current_value:
            return None

        if not is_share_path(current_value):
            return current_value


def normalize_session_name(value: str) -> str:
    return value.replace(".", "_")


def main() -> None:
    ensure_src_dir(CONFIG.src_dir)
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--full-screen", action="store_true")
    parser.add_argument("--full-screen-bordered", action="store_true")
    parser.add_argument("-q", "--query")
    parser.add_argument("name", nargs="?")
    args = parser.parse_args()

    if args.query is not None and args.name is not None:
        print(
            "Usage: ts [--full-screen] [--full-screen-bordered] [-q query] [name]",
            file=sys.stderr,
        )
        sys.exit(2)

    query_value = args.query if args.query is not None else args.name
    value = query_value.strip() if query_value is not None else prompt_input(CONFIG.prompt).strip()

    if value == CONFIG.exit_signal:
        return

    if not value:
        return

    if is_share_path(value):
        share_result = handle_share_path(value)
        if share_result is None:
            return
        value = share_result

    if is_tmp_path(value):
        tmp_dir = tmp_target_dir(value)
        if tmp_dir is None:
            return

        tmp_dir.mkdir(parents=True, exist_ok=True)
        ensure_session(normalize_session_name(value), tmp_dir)
        return

    if is_git_url(value):
        clean = clean_repo_path(value)
        repo_dir = CONFIG.src_dir / clean

        if not (repo_dir / ".git").is_dir():
            repo_dir.parent.mkdir(parents=True, exist_ok=True)
            run(["git", "clone", value, str(repo_dir)])

        ensure_session(normalize_session_name(clean), repo_dir)
        return

    session_name = normalize_session_name(value)
    cwd = Path.cwd()

    ensure_session(session_name, cwd)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
