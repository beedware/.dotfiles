#!/usr/bin/env python3
import argparse
import shlex
import subprocess
import sys
from dataclasses import dataclass
from enum import Enum


class ComponentType(Enum):
    ERASER = "ERASER"
    STYLUS = "STYLUS"
    PAD = "PAD"


@dataclass(frozen=True)
class TabletComponent:
    name: str
    id: str
    component_type: str


@dataclass(frozen=True)
class Resolution:
    width: int
    height: int


@dataclass(frozen=True)
class Position:
    x: int
    y: int


@dataclass(frozen=True)
class Screen:
    id: int
    name: str
    is_primary: bool
    resolution: Resolution
    position: Position

    @property
    def output_spec(self) -> str:
        return (
            f"{self.resolution.width}x{self.resolution.height}"
            f"+{self.position.x}+{self.position.y}"
        )


@dataclass(frozen=True)
class Keybind:
    key: str
    binding: str

    def apply(self, component: TabletComponent) -> None:
        run_xsetwacom(
            "set",
            component.id,
            "Button",
            self.key,
            *shlex.split(self.binding),
        )


@dataclass(frozen=True)
class TabletConfig:
    name: str
    device_match: str
    area_components: tuple[ComponentType, ...]
    keybinds: dict[ComponentType, tuple[Keybind, ...]]


TABLET_CONFIGS: tuple[TabletConfig, ...] = (
    TabletConfig(
        name="Huion",
        device_match="HID 256:006e",
        area_components=(ComponentType.STYLUS,),
        keybinds={
            ComponentType.PAD: (
                Keybind(key="1", binding="key Super_L Alt_L 1"),
                Keybind(key="2", binding="key Super_L Alt_L 4"),
                Keybind(key="15", binding="key Super_L Alt_L 1"),
                Keybind(key="16", binding="key Super_L Alt_L 1"),
            )
        },
    ),
    TabletConfig(
        name="Wacom One",
        device_match="Wacom One pen tablet small",
        area_components=(ComponentType.ERASER, ComponentType.STYLUS),
        keybinds={ComponentType.STYLUS: (Keybind(key="2", binding="+2"),)},
    ),
)


ScreenTarget = int | str
ALL_MONITORS = "all"


def run_xsetwacom(
    *args: str, capture_output: bool = False
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["xsetwacom", *args],
        capture_output=capture_output,
        text=True,
        check=False,
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="xswacomon",
        description="Map configured drawing tablets to an active monitor.",
    )
    parser.add_argument(
        "target",
        nargs="?",
        help="monitor id to map to, 'all', or a direction: left, right",
    )
    parser.add_argument(
        "--list-screens",
        action="store_true",
        help="show active monitors from xrandr and exit",
    )
    parser.add_argument(
        "--list-tablets",
        action="store_true",
        help="show matching configured tablet devices from xsetwacom and exit",
    )
    parser.add_argument(
        "--no-keybinds",
        action="store_true",
        help="map tablet areas without applying button bindings",
    )
    return parser


def parse_target(target: str) -> ScreenTarget:
    if target in ("left", "right", ALL_MONITORS):
        return target

    try:
        return int(target)
    except ValueError as error:
        raise ValueError(
            "target must be a monitor id, 'all', 'left', or 'right'"
        ) from error


def parse_tablet_component(line: str) -> TabletComponent | None:
    parts = line.split("\t")
    if len(parts) < 3:
        return None

    return TabletComponent(
        name=parts[0].strip(),
        id=parts[1].strip().removeprefix("id: "),
        component_type=parts[2].strip().removeprefix("type: "),
    )


def list_tablet_components() -> list[TabletComponent]:
    output = run_xsetwacom("list", capture_output=True).stdout
    return [
        component
        for line in output.splitlines()
        if (component := parse_tablet_component(line)) is not None
    ]


def components_for_tablet(
    components: list[TabletComponent], config: TabletConfig
) -> list[TabletComponent]:
    return [
        component for component in components if config.device_match in component.name
    ]


def parse_screen(line: str) -> Screen:
    parts = line.strip().split()
    screen_id = int(parts[0].removesuffix(":"))
    status = parts[1]
    geometry = parts[2]

    resolution_part = geometry.split("+")[0]
    width = int(resolution_part.split("/")[0])
    height = int(resolution_part.split("/")[1].split("x")[-1])
    position_x = int(geometry.split("+")[-2])
    position_y = int(geometry.split("+")[-1])

    return Screen(
        id=screen_id,
        name=parts[-1],
        is_primary="*" in status,
        resolution=Resolution(width=width, height=height),
        position=Position(x=position_x, y=position_y),
    )


def list_screens() -> list[Screen]:
    output = subprocess.run(
        ["xrandr", "--listactivemonitors"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.splitlines()

    return [parse_screen(line) for line in output[1:]]


def find_screen_by_id(screens: list[Screen], screen_id: int) -> Screen | None:
    return next((screen for screen in screens if screen.id == screen_id), None)


def find_screen_by_output(screens: list[Screen], output: str) -> Screen | None:
    return next(
        (screen for screen in screens if output in (screen.name, screen.output_spec)),
        None,
    )


def sorted_screens(screens: list[Screen]) -> list[Screen]:
    return sorted(
        screens,
        key=lambda screen: (screen.position.x, screen.position.y, screen.id),
    )


def relative_screen(screens: list[Screen], current: Screen, direction: str) -> Screen:
    ordered_screens = sorted_screens(screens)
    current_index = ordered_screens.index(current)
    next_index = current_index + (-1 if direction == "left" else 1)

    if next_index < 0 or next_index >= len(ordered_screens):
        return current

    return ordered_screens[next_index]


def component_by_type(
    components: list[TabletComponent], component_type: ComponentType
) -> TabletComponent | None:
    return next(
        (
            component
            for component in components
            if component.component_type == component_type.value
        ),
        None,
    )


def get_default_area(component: TabletComponent) -> list[str]:
    return run_xsetwacom(
        "get", component.id, "Area", capture_output=True
    ).stdout.split()


def get_mapped_output(component: TabletComponent) -> str:
    return run_xsetwacom(
        "get", component.id, "MapToOutput", capture_output=True
    ).stdout.strip()


def mapped_screen(
    screens: list[Screen], components: list[TabletComponent], config: TabletConfig
) -> Screen | None:
    for component_type in config.area_components:
        component = component_by_type(components, component_type)
        if not component:
            continue

        screen = find_screen_by_output(screens, get_mapped_output(component))
        if screen:
            return screen

    return None


def apply_keybinds(components: list[TabletComponent], config: TabletConfig) -> None:
    for component_type, keybinds in config.keybinds.items():
        component = component_by_type(components, component_type)
        if not component:
            continue

        for keybind in keybinds:
            keybind.apply(component)


def configure_tablet_area(
    screen: Screen | None, components: list[TabletComponent], config: TabletConfig
) -> None:
    for component_type in config.area_components:
        component = component_by_type(components, component_type)
        if not component:
            continue

        area = get_default_area(component)[2:]
        if len(area) < 2:
            continue

        area_x = int(area[0])
        area_y = int(area[1])
        output = "desktop"

        if screen:
            area_y = int(area_x * (screen.resolution.height / screen.resolution.width))
            output = screen.output_spec

        run_xsetwacom("set", component.id, "Area", "0", "0", str(area_x), str(area_y))
        run_xsetwacom("set", component.id, "MapToOutput", output)


def configured_tablets(
    components: list[TabletComponent],
) -> list[tuple[TabletConfig, list[TabletComponent]]]:
    return [
        (config, tablet_components)
        for config in TABLET_CONFIGS
        if (tablet_components := components_for_tablet(components, config))
    ]


def print_screens(screens: list[Screen]) -> None:
    for screen in sorted_screens(screens):
        primary = " primary" if screen.is_primary else ""
        print(f"{screen.id}: {screen.name} {screen.output_spec}{primary}")

    print(f"{ALL_MONITORS}: All monitors")


def print_tablets(tablets: list[tuple[TabletConfig, list[TabletComponent]]]) -> None:
    if not tablets:
        print("No configured tablets found")
        return

    for config, components in tablets:
        print(f"{config.name}:")
        for component in components:
            print(f"  {component.id}: {component.component_type} - {component.name}")


def select_screen(
    target: ScreenTarget,
    screens: list[Screen],
    tablets: list[tuple[TabletConfig, list[TabletComponent]]],
) -> Screen | None:
    if target == ALL_MONITORS:
        return None

    if isinstance(target, int):
        return find_screen_by_id(screens, target)

    for config, components in tablets:
        current_screen = mapped_screen(screens, components, config)
        if current_screen:
            return relative_screen(screens, current_screen, target)

    print("Could not determine current xsetwacom output", file=sys.stderr)
    return None


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    if args.list_tablets:
        print_tablets(configured_tablets(list_tablet_components()))
        return 0

    if args.list_screens:
        screens = list_screens()
        print_screens(screens)
        return 0

    if not args.target:
        parser.error("target is required unless using --list-screens or --list-tablets")

    try:
        target = parse_target(args.target)
    except ValueError as error:
        parser.error(str(error))

    components = list_tablet_components()
    tablets = configured_tablets(components)
    if not tablets:
        print("No configured tablets found", file=sys.stderr)
        return 1

    screens = list_screens()
    screen = select_screen(target, screens, tablets)
    is_all_monitors = target == ALL_MONITORS

    if not screen and not is_all_monitors:
        print(f"Could not find screen for target: {args.target}", file=sys.stderr)
        return 1

    for config, tablet_components in tablets:
        if not args.no_keybinds:
            apply_keybinds(tablet_components, config)
        configure_tablet_area(screen, tablet_components, config)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
