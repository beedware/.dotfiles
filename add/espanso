#!/bin/sh
set -eu

# tags: #pkg

VERSION="2.4.1"
TARBALL="espanso-${VERSION}.tar.gz"
CHECKSUM="3121627138be4b1f106b8dfd73fb4b7030ecb44c6a8f4e7628a1174b58e5cfe2"
URL="https://github.com/espanso/espanso/archive/refs/tags/v${VERSION}.tar.gz"
FLAVOR="x11"

case "${1:-}" in
    "") ;;
    --x11) FLAVOR="x11" ;;
    --wayland) FLAVOR="wayland" ;;
    *) echo "usage: $0 [--x11|--wayland]" >&2; exit 1 ;;
esac

sudo xbps-install -Sy \
    curl \
    dbus-devel \
    gcc \
    libX11-devel \
    libXtst-devel \
    libxkbcommon-devel \
    make \
    openssl-devel \
    pkg-config \
    tar \
    wxWidgets-gtk3-devel

command -v cargo >/dev/null 2>&1 || { echo "cargo is not installed. Run add/rust first."; exit 1; }

if [ "$FLAVOR" = "wayland" ]; then
    FEATURES="wayland,modulo,vendored-tls"
else
    FEATURES="modulo,vendored-tls"
fi

BIN_NAME="espanso-${FLAVOR}"
INSTALL_DIR="/opt/${BIN_NAME}"
TARGET_BIN="${INSTALL_DIR}/bin/${BIN_NAME}"
BIN_LINK="/usr/local/bin/${BIN_NAME}"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR"

curl -fL -o "$TARBALL" "$URL"
printf '%s  %s\n' "$CHECKSUM" "$TARBALL" | sha256sum --check
tar -xf "$TARBALL"

cd "espanso-${VERSION}"
cargo build --release --no-default-features --features "$FEATURES"

sudo rm -rf "$INSTALL_DIR"
sudo mkdir -p "${INSTALL_DIR}/bin"
sudo cp target/release/espanso "$TARGET_BIN"
sudo chmod +x "$TARGET_BIN"

sudo ln -sfn "$TARGET_BIN" "$BIN_LINK"

echo "Espanso ${FLAVOR} installed: $BIN_LINK -> $TARGET_BIN"
