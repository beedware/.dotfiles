{
    "show_completions_on_input": false,
    "buffer_font_features": {
        "calt": false
    },
    "title_bar": {
        "show_sign_in": false,
        "show_branch_status_icon": true
    },
    "status_bar": {
        "show_active_file": true
    },
    "tab_bar": {
        "show": false
    },
    "cli_default_open_behavior": "existing_window",
    "project_panel": {
        "starts_open": false,
        "indent_guides": {
            "show": "never"
        }
    },
    "indent_guides": {
        "enabled": false
    },
    "vim": {
        "cursor_shape": {
            "replace": "block",
            "insert": "block"
        },
        "use_smartcase_find": true,
        "use_system_clipboard": "never",
        "toggle_relative_line_numbers": true
    },
    "which_key": {
        "enabled": true
    },
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "cursor_blink": false,
    "git": {
        "inline_blame": {
            "enabled": false
        }
    },
    "relative_line_numbers": "enabled",
    "toolbar": {
        "agent_review": false,
        "selections_menu": false,
        "quick_actions": false,
        "breadcrumbs": false
    },
    "disable_ai": true,
    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Zed (Default)"
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false
    },
    "vim_mode": true,
    "ui_font_size": 16,
    "buffer_font_size": 16,
    "theme": {
        "mode": "system",
        "light": "Modus Operandi",
        "dark": "Modus Vivendi"
    },
    "languages": {
        "Python": {
            "language_servers": ["ty", "ruff"]
        }
    }
}
