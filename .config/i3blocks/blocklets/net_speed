#!/bin/sh

format_rate() {
    awk -v bytes="$1" 'BEGIN {
        if (bytes >= 1073741824) {
            printf "%.0fG", bytes / 1073741824
        } else if (bytes >= 1048576) {
            printf "%.0fM", bytes / 1048576
        } else if (bytes >= 1024) {
            printf "%.0fK", bytes / 1024
        } else {
            printf "%dB", bytes
        }
    }'
}

IFACE=${IFACE:-$(ip route 2>/dev/null | awk '$1 == "default" { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')}
[ -n "$IFACE" ] || exit 0

RX_FILE="/sys/class/net/$IFACE/statistics/rx_bytes"
TX_FILE="/sys/class/net/$IFACE/statistics/tx_bytes"
[ -r "$RX_FILE" ] && [ -r "$TX_FILE" ] || exit 0

IFS= read -r RX < "$RX_FILE" || exit 0
IFS= read -r TX < "$TX_FILE" || exit 0
NOW=$(date +%s)
STATE_FILE="/tmp/i3blocks_net_speed_$IFACE"

if [ -r "$STATE_FILE" ]; then
    IFS=' ' read -r PREV_NOW PREV_RX PREV_TX < "$STATE_FILE"
fi

printf '%s %s %s\n' "$NOW" "$RX" "$TX" > "$STATE_FILE"

if [ -z "$PREV_NOW" ] || [ -z "$PREV_RX" ] || [ -z "$PREV_TX" ]; then
    printf '%s\n' "0B:0B"
    exit 0
fi

ELAPSED=$((NOW - PREV_NOW))
[ "$ELAPSED" -gt 0 ] || ELAPSED=1

DOWN=$(((RX - PREV_RX) / ELAPSED))
UP=$(((TX - PREV_TX) / ELAPSED))
[ "$DOWN" -ge 0 ] || DOWN=0
[ "$UP" -ge 0 ] || UP=0

printf '%s\n' "$(format_rate "$DOWN"):$(format_rate "$UP")"
