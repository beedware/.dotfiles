#!/usr/bin/env python3

import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

ACCESS_FILE: Path = Path.home() / "Compendium" / "Journal" / "marks.org"


@dataclass(frozen=True)
class Mark:
    title: str
    url: str
    tags: tuple[str, ...]


Marks = tuple[Mark, ...]


def read_file(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def die(message: str) -> None:
    raise SystemExit(message)


def usage() -> str:
    return f"Usage: {Path(sys.argv[0]).name} [marks_file]"


def get_marks_file(args: list[str]) -> Path:
    if len(args) > 1:
        die("Error: too many arguments")

    if not args:
        return ACCESS_FILE

    arg = args[0]

    if arg in ("-h", "--help"):
        print(usage())
        raise SystemExit(0)

    if arg.startswith("-"):
        die(f"Error: unknown option: {arg}")

    return Path(arg).expanduser()


def parse_heading(line: str) -> tuple[str, tuple[str, ...]] | None:
    if not line.startswith("* "):
        return None

    text: str = line.removeprefix("* ").strip()
    parts: list[str] = text.rsplit(" ", maxsplit=1)

    if len(parts) == 1 or not is_tag_text(parts[1]):
        return text, ()

    title: str = parts[0].strip()
    tags: tuple[str, ...] = tuple(parts[1].strip(":").split(":"))
    return title, tags


def is_tag_text(text: str) -> bool:
    return text.startswith(":") and text.endswith(":") and len(text) > 2


def parse_url(line: str) -> str | None:
    line = line.strip()

    if not line.startswith(":URL:"):
        return None

    return line.removeprefix(":URL:").strip()


def get_marks(text: str) -> Marks:
    marks: list[Mark] = []
    title: str | None = None
    tags: tuple[str, ...] = ()
    lines: list[str] = text.splitlines()

    for line in lines:
        heading = parse_heading(line)

        if heading:
            title, tags = heading
            continue

        url = parse_url(line)

        if title and url:
            marks.append(Mark(title, url, tags))

    return tuple(marks)


def select_mark(marks: Marks) -> Mark | None:
    marks_by_title: dict[str, Mark] = {
        mark.title: mark for mark in marks
    }
    titles: str = "\n".join(mark.title for mark in marks)
    rofi = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "Marks"],
        input=titles,
        capture_output=True,
        text=True,
        check=False,
    )

    if rofi.returncode != 0:
        return None

    choice: str = rofi.stdout.strip()

    if not choice:
        return None

    return marks_by_title.get(choice)


def copy_wayland(text: str) -> None:
    if shutil.which("wl-copy") is None:
        die("Error: wayland session detected but wl-copy is not installed")

    subprocess.run(["wl-copy"], input=text, text=True, check=True)


def copy_x11(text: str) -> None:
    if shutil.which("xclip") is not None:
        subprocess.run(
            ["xclip", "-selection", "clipboard"], input=text, text=True, check=True
        )
        return

    if shutil.which("xsel") is not None:
        subprocess.run(
            ["xsel", "--clipboard", "--input"], input=text, text=True, check=True
        )
        return

    die("Error: x11 session detected but neither xclip nor xsel is installed")


def copy_url(url: str) -> None:
    session_type: str = os.environ.get("XDG_SESSION_TYPE", "")

    if session_type == "wayland":
        copy_wayland(url)
        return

    if session_type == "x11":
        copy_x11(url)
        return

    die(f"Error: unsupported or unknown session type: {session_type or 'unset'}")


def main() -> None:
    marks_file: Path = get_marks_file(sys.argv[1:])

    if not marks_file.is_file():
        die(f"Error: marks file not found: {marks_file}")

    text: str = read_file(marks_file)
    marks: Marks = get_marks(text)
    mark: Mark | None = select_mark(marks)

    if mark is None:
        return

    copy_url(mark.url)


if __name__ == "__main__":
    main()
