#!/usr/bin/env python3

import os
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

ACCESS_FILE: Path = Path.home() / "Compendium" / "Journal" / "marks.org"


@dataclass(frozen=True)
class Mark:
    title: str
    url: str
    tags: tuple[str, ...]


@dataclass(frozen=True)
class Options:
    marks_file: Path
    copy_only: bool


Marks = tuple[Mark, ...]


def read_file(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def die(message: str) -> None:
    raise SystemExit(message)


def usage() -> str:
    return f"Usage: {Path(sys.argv[0]).name} [-c|--copy] [marks_file]"


def get_options(args: list[str]) -> Options:
    copy_only = False
    marks_file: Path | None = None

    for arg in args:
        if arg in ("-h", "--help"):
            print(usage())
            raise SystemExit(0)

        if arg in ("-c", "--copy"):
            copy_only = True
            continue

        if arg.startswith("-"):
            die(f"Error: unknown option: {arg}")

        if marks_file is not None:
            die("Error: too many arguments")

        marks_file = Path(arg).expanduser()

    return Options(marks_file or ACCESS_FILE, copy_only)


def parse_heading(line: str) -> tuple[str, tuple[str, ...]] | None:
    if not line.startswith("* "):
        return None

    text: str = line.removeprefix("* ").strip()
    parts: list[str] = text.rsplit(" ", maxsplit=1)

    if len(parts) == 1 or not is_tag_text(parts[1]):
        return text, ()

    title: str = parts[0].strip()
    tags: tuple[str, ...] = tuple(parts[1].strip(":").split(":"))
    return title, tags


def is_tag_text(text: str) -> bool:
    return text.startswith(":") and text.endswith(":") and len(text) > 2


def parse_url(line: str) -> str | None:
    line = line.strip()

    if not line.startswith(":URL:"):
        return None

    return line.removeprefix(":URL:").strip()


def get_marks(text: str) -> Marks:
    marks: list[Mark] = []
    title: str | None = None
    tags: tuple[str, ...] = ()
    lines: list[str] = text.splitlines()

    for line in lines:
        heading = parse_heading(line)

        if heading:
            title, tags = heading
            continue

        url = parse_url(line)

        if title and url and "archive" not in tags:
            marks.append(Mark(title, url, tags))

    return tuple(marks)


def select_mark(marks: Marks) -> Mark | None:
    marks_by_title: dict[str, Mark] = {
        mark.title: mark for mark in marks
    }
    titles: str = "\n".join(mark.title for mark in marks)
    rofi = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "Marks"],
        input=titles,
        capture_output=True,
        text=True,
        check=False,
    )

    if rofi.returncode != 0:
        return None

    choice: str = rofi.stdout.strip()

    if not choice:
        return None

    return marks_by_title.get(choice)


def copy_wayland(text: str) -> None:
    if shutil.which("wl-copy") is None:
        die("Error: wayland session detected but wl-copy is not installed")

    subprocess.run(["wl-copy"], input=text, text=True, check=True)


def read_wayland_clipboard() -> str | None:
    if shutil.which("wl-paste") is None:
        die("Error: wayland session detected but wl-paste is not installed")

    clipboard = subprocess.run(
        ["wl-paste", "--no-newline"],
        capture_output=True,
        text=True,
        check=False,
    )

    if clipboard.returncode != 0 or not clipboard.stdout:
        return None

    return clipboard.stdout


def paste_wayland() -> None:
    if shutil.which("wtype") is None:
        die("Error: wayland session detected but wtype is not installed")

    subprocess.run(["wtype", "-M", "ctrl", "v", "-m", "ctrl"], check=True)


def copy_x11(text: str) -> None:
    if shutil.which("xclip") is not None:
        subprocess.run(
            ["xclip", "-selection", "clipboard"], input=text, text=True, check=True
        )
        return

    if shutil.which("xsel") is not None:
        subprocess.run(
            ["xsel", "--clipboard", "--input"], input=text, text=True, check=True
        )
        return

    die("Error: x11 session detected but neither xclip nor xsel is installed")


def read_x11_clipboard() -> str | None:
    if shutil.which("xclip") is not None:
        clipboard = subprocess.run(
            ["xclip", "-selection", "clipboard", "-out"],
            capture_output=True,
            text=True,
            check=False,
        )

        if clipboard.returncode != 0 or not clipboard.stdout:
            return None

        return clipboard.stdout

    if shutil.which("xsel") is not None:
        clipboard = subprocess.run(
            ["xsel", "--clipboard", "--output"],
            capture_output=True,
            text=True,
            check=False,
        )

        if clipboard.returncode != 0 or not clipboard.stdout:
            return None

        return clipboard.stdout

    die("Error: x11 session detected but neither xclip nor xsel is installed")


def paste_x11() -> None:
    if shutil.which("xdotool") is None:
        die("Error: x11 session detected but xdotool is not installed")

    subprocess.run(["xdotool", "key", "--clearmodifiers", "ctrl+v"], check=True)


def copy_url(url: str) -> None:
    session_type: str = os.environ.get("XDG_SESSION_TYPE", "")

    if session_type == "wayland":
        copy_wayland(url)
        return

    if session_type == "x11":
        copy_x11(url)
        return

    die(f"Error: unsupported or unknown session type: {session_type or 'unset'}")


def read_clipboard() -> str | None:
    session_type: str = os.environ.get("XDG_SESSION_TYPE", "")

    if session_type == "wayland":
        return read_wayland_clipboard()

    if session_type == "x11":
        return read_x11_clipboard()

    die(f"Error: unsupported or unknown session type: {session_type or 'unset'}")


def paste_clipboard() -> None:
    session_type: str = os.environ.get("XDG_SESSION_TYPE", "")

    if session_type == "wayland":
        paste_wayland()
        return

    if session_type == "x11":
        paste_x11()
        return

    die(f"Error: unsupported or unknown session type: {session_type or 'unset'}")


def paste_url(url: str) -> None:
    previous_clipboard: str | None = read_clipboard()

    copy_url(url)
    try:
        time.sleep(0.05)
        paste_clipboard()
    finally:
        if previous_clipboard is not None:
            copy_url(previous_clipboard)


def main() -> None:
    options: Options = get_options(sys.argv[1:])
    marks_file: Path = options.marks_file

    if not marks_file.is_file():
        die(f"Error: marks file not found: {marks_file}")

    text: str = read_file(marks_file)
    marks: Marks = get_marks(text)
    mark: Mark | None = select_mark(marks)

    if mark is None:
        return

    if options.copy_only:
        copy_url(mark.url)
        return

    paste_url(mark.url)


if __name__ == "__main__":
    main()
